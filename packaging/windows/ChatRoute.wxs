<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="ChatRoute"
    Manufacturer="ChatRoute"
    Version="$(var.ProductVersion)"
    UpgradeCode="{42B4BF3C-E660-4C83-96AA-56A4426B96A2}"
    Scope="perMachine"
    Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="ChatRouteIcon" SourceFile="$(var.SourceDir)\AppIcon.ico" />
    <Property Id="ARPPRODUCTICON" Value="ChatRouteIcon" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="ChatRoute">
        <Component Id="ChatRouteExecutable" Guid="{12277B76-8F43-441F-AFFD-63FB150BB29E}">
          <File Id="ChatRouteExe" Source="$(var.SourceDir)\ChatRoute.exe" KeyPath="yes" />
        </Component>
        <Component Id="ChatRouteReadme" Guid="{E92E4DFB-DB47-4059-AC08-2BFA1E8FFF4C}">
          <File Id="ReadmeMd" Source="$(var.SourceDir)\README.md" KeyPath="yes" />
        </Component>
        <Component Id="ChatRouteConfigExample" Guid="{0C195660-3D69-4675-A47D-2B2F97B01084}">
          <File Id="ConfigExampleToml" Source="$(var.SourceDir)\config.example.toml" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="ChatRoute">
        <Component Id="ChatRouteStartMenuShortcut" Guid="{7F8F4957-5919-4CD2-8B22-7598FB648600}">
          <Shortcut
            Id="ChatRouteStartMenuShortcut"
            Name="ChatRoute"
            Description="Open ChatRoute"
            Target="[INSTALLFOLDER]ChatRoute.exe"
            WorkingDirectory="INSTALLFOLDER"
            Icon="ChatRouteIcon" />
          <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
          <RegistryValue
            Root="HKLM"
            Key="Software\ChatRoute"
            Name="StartMenuShortcut"
            Type="integer"
            Value="1"
            KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="ChatRouteDesktopShortcut" Guid="{807CD976-6CCB-49F8-B0D2-E01493319A63}">
        <Shortcut
          Id="ChatRouteDesktopShortcut"
          Name="ChatRoute"
          Description="Open ChatRoute"
          Target="[INSTALLFOLDER]ChatRoute.exe"
          WorkingDirectory="INSTALLFOLDER"
          Icon="ChatRouteIcon" />
        <RegistryValue
          Root="HKLM"
          Key="Software\ChatRoute"
          Name="DesktopShortcut"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="ChatRoute" Level="1">
      <ComponentRef Id="ChatRouteExecutable" />
      <ComponentRef Id="ChatRouteReadme" />
      <ComponentRef Id="ChatRouteConfigExample" />
      <ComponentRef Id="ChatRouteStartMenuShortcut" />
      <ComponentRef Id="ChatRouteDesktopShortcut" />
    </Feature>
  </Package>
</Wix>
